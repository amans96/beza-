# Database connection URL for Prisma (PostgreSQL / Supabase)
# Local development format:
# DATABASE_URL="postgresql://<username>:<password>@localhost:5432/<database_name>?schema=public"
DATABASE_URL="postgresql://postgres@localhost:5432/beza_db?schema=public"

# Direct connection URL (used for migrations; for local dev, can match DATABASE_URL)
# Supabase format:
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres@localhost:5432/beza_db?schema=public"
